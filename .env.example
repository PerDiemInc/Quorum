# Copy to .env; only the app's loopback port is published.
QUORUM_PORT=4710
# Set this and start --profile speech to enable container speech recognition.
WHISPER_URL=
WHISPER_REMOTE_MODEL=Systran/faster-whisper-tiny.en
# Optional --profile hf model. Use a compatible GGUF file from Hugging Face.
HF_MODEL_REPO=Qwen/Qwen2.5-0.5B-Instruct-GGUF
HF_MODEL_FILE=qwen2.5-0.5b-instruct-q4_k_m.gguf
